<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Titre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NotificationApp Kotlin"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Statut de connexion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/statusIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/holo_red_light" />

            <TextView
                android:id="@+id/textConnectionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Déconnecté"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- Boutons de contrôle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/buttonToggleService"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Démarrer Service"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/buttonClearMessages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Effacer Messages"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- Boutons Socket.IO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/buttonConnectSocketIO"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connecter Socket.IO"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@android:color/holo_blue_light" />

            <Button
                android:id="@+id/buttonConnectWebSocket"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Connecter WebSocket"
                android:layout_marginStart="4dp"
                android:backgroundTint="@android:color/holo_green_light" />

        </LinearLayout>

        <!-- Boutons de test -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/buttonSendTestMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Envoyer Test"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@android:color/holo_orange_light" />

            <Button
                android:id="@+id/buttonDisconnect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Déconnecter"
                android:layout_marginStart="4dp"
                android:backgroundTint="@android:color/holo_red_light" />

        </LinearLayout>

        <!-- Informations de compatibilité -->
        <LinearLayout
            android:id="@+id/layoutCompatibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="@android:color/white"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compatibilité"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textCompatibilityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vérification en cours..."
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/textOsVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OS: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textModelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modèle: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marque: "
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textFeaturesAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fonctionnalités disponibles: "
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Tests de fonctionnalités -->
        <LinearLayout
            android:id="@+id/layoutFeatureTests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="@android:color/white"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tests de Fonctionnalités"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textWebsocketTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WebSocket: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textNotificationsTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifications: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textBackgroundTaskTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tâches en arrière-plan: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textPersistentNotificationTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notification persistante: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textLocalStorageTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stockage local: "
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Informations de l'appareil -->
        <LinearLayout
            android:id="@+id/layoutDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:background="@android:color/white"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informations de l'Appareil"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textPlatform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Plateforme: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textServiceActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Service actif: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textPollingActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Polling actif: "
                android:textSize="12sp"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/textDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ID Appareil: "
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Messages -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Messages Reçus"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textMessagesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aucun message"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMessages"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@android:color/black"
            android:padding="8dp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
